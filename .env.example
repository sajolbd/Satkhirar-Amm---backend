# ============================================
# CRITICAL: Set these FIRST for Vercel to work
# ============================================

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Get from: MongoDB Atlas → Connect → Drivers (Node.js)
MONGODB_URI=mongodb+srv://satkhirar-admin:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Database name
MONGODB_DB_NAME=satkhirar-amm

# JWT Secret (min 32 characters, use strong random string)
JWT_SECRET=change-this-to-32-character-random-secret-key

# Node Environment
NODE_ENV=production

# ============================================
# Frontend URLs (for CORS)
# ============================================

# Vercel deployed URLs for your website and dashboard
CLIENT_ORIGINS=https://satkhirar-amm-website.vercel.app,https://satkhirar-amm-dashboard.vercel.app

# Allow Vercel preview deployments
ALLOW_VERCEL_PREVIEWS=true

# ============================================
# Admin Setup
# ============================================

PORT=5000
ADMIN_NAME=Satkhirar Amm Admin
ADMIN_EMAIL=admin@satkhiraramm.com
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=change-this-admin-password

# ============================================
# Optional: Database Settings
# ============================================

# Timeout for MongoDB server selection (capped at 5000ms by the API)
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Skip database seeding on startup (default: false)
SKIP_DATABASE_SEED=false

# ============================================
# VERCEL DEPLOYMENT REQUIREMENTS
# ============================================
# 1. MongoDB Atlas: Whitelist 0.0.0.0/0 in Network Access
# 2. Replace MONGODB_URI with your actual credentials
# 3. Replace JWT_SECRET with a 32+ character random string
# 4. Update CLIENT_ORIGINS with your Vercel URLs
# 5. Go to Vercel project → Settings → Environment Variables
# 6. Add all these variables with YOUR values
# 7. Re-deploy on Vercel

